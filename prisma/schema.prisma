// Flowspace — auth (Better Auth) + encrypted vault schema
// Runtime can use Prisma Accelerate (prisma://). Migrations use DIRECT_DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[] @relation("InvitationInviter")
  auditLogs   AuditLog[]
  twofactors  TwoFactor[]
  createdDocuments Document[] @relation("DocumentAuthor")
  assignedTasks    Task[]     @relation("TaskAssignee")
  proposalsCreated ActionProposal[] @relation("ProposalCreatedBy")
  proposalsApproved ActionProposal[] @relation("ProposalApprovedBy")
  desktopStates    DesktopState[]

  @@map("user")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @map("user_id")
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ─── Better Auth organization plugin ─────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members          Member[]
  invitations      Invitation[]
  projects         Project[]
  encryptionKey    OrganizationEncryptionKey?
  auditLogs        AuditLog[]
  auditSigningKeys AuditSigningKey[]

  @@map("organization")
}

// ─── Desktop persistence ─────────────────────────────────────────────────────

model DesktopState {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  name      String   @default("default")
  windows   Json     @default("[]")
  desktop   Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, name])
  @@index([projectId])
  @@map("desktop_state")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  email          String
  role           String
  status         String    @default("pending")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  inviterId      String    @map("inviter_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─── Better Auth API key plugin ──────────────────────────────────────────────

model Apikey {
  id                  String    @id @default(cuid())
  configId            String    @default("default") @map("config_id")
  name                String?
  start               String?
  referenceId         String    @map("reference_id")
  prefix              String?
  key                 String
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at")
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?      @map("rate_limit_time_window")
  rateLimitMax        Int?      @map("rate_limit_max")
  requestCount        Int       @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ─── Vault domain ────────────────────────────────────────────────────────────

model OrganizationEncryptionKey {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  wrappedDek     String   @map("wrapped_dek")
  wrapIv         String   @map("wrap_iv")
  wrapAuthTag    String   @map("wrap_auth_tag")
  algorithm      String   @default("aes-256-gcm")
  keyVersion     Int      @default(1) @map("key_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_encryption_key")
}

model Project {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments Environment[]
  secrets      Secret[]
  documents    Document[]
  tasks        Task[]
  integrations Integration[]
  repositories Repository[]
  files        ProjectFile[]
  agentSessions AgentSession[]
  proposals    ActionProposal[]
  desktopStates DesktopState[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("project")
}

model Environment {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secrets Secret[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("environment")
}

enum SecretType {
  password
  env_var
  ssh_keypair
  api_token
  certificate
  json
  file
  note
}

model Secret {
  id             String     @id @default(cuid())
  projectId      String     @map("project_id")
  environmentId  String     @map("environment_id")
  name           String
  description    String?
  type           SecretType @default(env_var)
  metadata       Json?
  currentVersion Int        @default(0) @map("current_version")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  versions    SecretVersion[]

  @@unique([environmentId, name])
  @@index([projectId])
  @@index([environmentId])
  @@map("secret")
}

model SecretVersion {
  id          String   @id @default(cuid())
  secretId    String   @map("secret_id")
  version     Int
  ciphertext  String
  iv          String
  authTag     String   @map("auth_tag")
  algorithm   String   @default("aes-256-gcm")
  keyVersion  Int      @default(1) @map("key_version")
  contentType String?  @map("content_type")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([secretId, version])
  @@index([secretId])
  @@map("secret_version")
}

enum TaskStatus {
  todo
  in_progress
  done
}

model Document {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  title       String
  content     String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("DocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("document")
}

model Task {
  id          String     @id @default(cuid())
  projectId   String     @map("project_id")
  title       String
  description String?
  status      TaskStatus @default(todo)
  assigneeId  String?    @map("assignee_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assigneeId])
  @@index([projectId, status])
  @@map("task")
}

model Integration {
  id                    String    @id @default(cuid())
  projectId             String    @map("project_id")
  provider              String
  name                  String
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  lastRefreshedAt       DateTime? @map("last_refreshed_at")
  scopes                String[]  @default([])
  metadata              Json?
  enabled               Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, provider])
  @@map("integration")
}

enum RepositoryProvider {
  github
  gitlab
  bitbucket
  custom
}

enum RepositoryAccessType {
  public
  private
}

enum RepositorySyncStatus {
  synced
  syncing
  error
  never_synced
}

model Repository {
  id           String               @id @default(cuid())
  projectId    String               @map("project_id")
  name         String
  description  String?
  provider     RepositoryProvider   @default(github)
  url          String
  branch       String               @default("main")
  accessType   RepositoryAccessType @default(private)
  credentialId String?              @map("credential_id")
  lastSyncAt   DateTime?            @map("last_sync_at")
  syncStatus   RepositorySyncStatus @default(never_synced) @map("sync_status")
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  createdById  String?              @map("created_by_id")

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  webhooks     RepositoryWebhook[]

  @@index([projectId])
  @@index([provider])
  @@index([projectId, provider])
  @@map("repository")
}

enum WebhookEvent {
  push
  pull_request
  release
  tag
  issue
  commit_comment
}

model RepositoryWebhook {
  id           String       @id @default(cuid())
  repositoryId String       @map("repository_id")
  event        WebhookEvent
  url          String
  secret       String
  enabled      Boolean      @default(true)
  githubHookId String?      @map("github_hook_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([repositoryId, event])
  @@map("repository_webhook")
}

enum FileType {
  artifact
  document
  config
  asset
  code
  data
  other
}

enum FileVisibility {
  private
  project
  public
}

model ProjectFile {
  id          String         @id @default(cuid())
  projectId   String         @map("project_id")
  name        String
  path        String
  type        FileType       @default(other)
  mimeType    String         @map("mime_type")
  size        Int
  storageId   String         @map("storage_id")
  url         String?
  version     Int            @default(1)
  parentId    String?        @map("parent_id")
  tags        String[]       @default([])
  metadata    Json?
  visibility  FileVisibility @default(private)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  createdById String?        @map("created_by_id")

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      ProjectFile?   @relation("FileVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions    ProjectFile[]  @relation("FileVersions")
  shares      FileShare[]

  @@index([projectId])
  @@index([projectId, type])
  @@index([path])
  @@index([storageId])
  @@map("project_file")
}

model FileShare {
  id           String      @id @default(cuid())
  fileId       String      @map("file_id")
  token        String      @unique
  expiresAt    DateTime?   @map("expires_at")
  maxDownloads Int?        @map("max_downloads")
  downloads    Int         @default(0)
  createdAt    DateTime    @default(now()) @map("created_at")
  createdById  String?     @map("created_by_id")

  file         ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([token])
  @@index([expiresAt])
  @@map("file_share")
}

// ─── Agent Runtimes ─────────────────────────────────────────────────────────

enum AgentStatus {
  idle
  running
  awaiting_approval
  completed
  failed
}

enum AgentType {
  coding
  content
  ops
  research
}

model AgentSession {
  id               String      @id @default(cuid())
  projectId        String      @map("project_id")
  name             String
  type             AgentType   @default(coding)
  status           AgentStatus @default(idle)
  prompt           String?
  daytonaSandboxId String?     @map("daytona_sandbox_id")
  sandboxUrl       String?     @map("sandbox_url")
  currentTask      String?     @map("current_task")
  metadata         Json?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposals    ActionProposal[]

  @@index([projectId])
  @@index([projectId, status])
  @@map("agent_session")
}

enum ProposalStatus {
  awaiting_approval
  approved
  rejected
  executed
  failed
}

enum ProposalRiskLevel {
  low
  medium
  high
  critical
}

model ActionProposal {
  id             String          @id @default(cuid())
  projectId      String          @map("project_id")
  agentSessionId String?         @map("agent_session_id")
  createdById    String?         @map("created_by_id")

  title          String
  description    String
  riskLevel      ProposalRiskLevel @default(medium)
  actionType     String
  targetSystem   String

  status         ProposalStatus  @default(awaiting_approval)
  payload        Json            @default("{}")

  approvedById   String?         @map("approved_by_id")
  approvalNotes  String?         @map("approval_notes")
  rejectionNotes String?         @map("rejection_notes")

  executedAt     DateTime?       @map("executed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentSession   AgentSession?   @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("ProposalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("action_proposal")
}

enum AuditAction {
  organization_create
  project_create
  project_update
  project_delete
  environment_create
  environment_update
  environment_delete
  secret_create
  secret_update
  secret_delete
  secret_reveal
  secret_export
  secret_import
  secret_version_create
  document_create
  document_update
  document_delete
  task_create
  task_update
  task_delete
  integration_create
  integration_delete
  agent_proxy_call
  proposal_create
  proposal_approve
  proposal_reject
  proposal_execute
  audit_export
  audit_key_rotate
  audit_log_read
  tool_call
  tool_call_blocked
  sandbox_create
  sandbox_delete
}

enum RetentionClass {
  ops
  audit
  regulated
  docs
}

model AuditSigningKey {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  keyVersion          Int       @map("key_version")
  publicKey           String    @map("public_key")
  privateKeyEncrypted String    @map("private_key_encrypted")
  active              Boolean   @default(true)
  retiredAt           DateTime? @map("retired_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, keyVersion])
  @@index([organizationId, active])
  @@map("audit_signing_key")
}

model AuditLog {
  id               String          @id @default(cuid())
  organizationId   String          @map("organization_id")
  orgSeq           Int?            @map("org_seq")
  actorUserId      String?         @map("actor_user_id")
  actorType        String          @default("user") @map("actor_type")
  action           AuditAction
  resourceType     String          @map("resource_type")
  resourceId       String?         @map("resource_id")
  metadata         Json?
  ipAddress        String?         @map("ip_address")
  userAgent        String?         @map("user_agent")
  retentionClass   RetentionClass  @default(audit) @map("retention_class")
  canonical        String?
  canonicalVersion Int             @default(1) @map("canonical_version")
  recordHash       String?         @map("record_hash")
  signature        String?
  signingKeyId     String?         @map("signing_key_id")
  prevHash         String?         @map("prev_hash")
  createdAt        DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, orgSeq])
  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}
