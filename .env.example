# ── Database (Neon / Postgres) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host-unpooled/db?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host-direct/db?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Encryption ───────────────────────────────────────────────────────────────
MASTER_KEY="generate-with: openssl rand -base64 32"

# ── AI Providers ─────────────────────────────────────────────────────────────
#
# OpenCode Zen — free OpenAI-compatible endpoint
#   Sign up at https://opencode.ai  →  Settings → API Keys
#   Base URL used internally: https://opencode.ai/zen/v1
#
OPENCODE_ZEN_API_KEY="sk-..."

#
# OpenRouter — gateway to 200+ models; "openrouter/free" routes to any free model
#   Sign up at https://openrouter.ai  →  Keys
#   Base URL used internally: https://openrouter.ai/api/v1
#
OPENROUTER_API_KEY="sk-or-v1-..."

# ── Appwrite Storage ──────────────────────────────────────────────────────────
APPWRITE_API_KEY=""
APPWRITE_BUCKET_ID=""
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID=""
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=""

# ── Cloudflare R2 Object Storage ──────────────────────────────────────────────
#
# Find your Account ID at: Cloudflare Dashboard → R2 → Overview
# Create an API token at:  Cloudflare Dashboard → R2 → Manage R2 API Tokens
#   Token permissions required: Object Read & Write
#
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
#
# WARNING: keep R2_PUBLIC_URL UNSET until a dedicated public bucket ships.
# The shared bucket cannot enforce DB visibility — with this set, every
# object is fetchable by key regardless of visibility. Once a separate
# public bucket exists, set this to its CDN URL and files with
# visibility="public" will use it instead of a presigned URL.
# Example: https://assets.yourdomain.com
#
# R2_PUBLIC_URL=""

# Max upload size in MB accepted by POST /files/upload and POST /files/presign.
# Default: 100. NaN or non-positive values fall back to 100.
R2_MAX_FILE_SIZE_MB="100"

# ── OAuth ─────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Optional external APIs ────────────────────────────────────────────────────
SERPER_API_KEY=""
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""
TAVILY_API_KEY=""
FIRECRAWL_API_KEY=""
EXA_API_KEY=""
ELEVENLABS_API_KEY=""
DEEPGRAM_API_KEY=""

# ── Daytona (Agent sandboxes) ──────────────────────────────────────────────
# Get your API key from https://app.daytona.io/dashboard/keys
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
